# ==============================================================================
# Wira-Voice Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Speech-to-Text (STT) Settings
# ------------------------------------------------------------------------------
# Deepgram API Key (Get yours at https://console.deepgram.com)
# Required only when using Cloud Deepgram Flux mode. Local Whisper.cpp does not need this.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 2. Decision Model (TypeSafe Jev) Settings
# ------------------------------------------------------------------------------
# Provider options: "openrouter" OR "typesafe"
JEV_PROVIDER=openrouter

# If using OpenRouter (https://openrouter.ai/keys) - Model: typesafe/jev-1.13
OPENROUTER_API_KEY=your_openrouter_api_key_here

# If using TypeSafe directly (https://typesafe.ai) - Endpoint: api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ------------------------------------------------------------------------------
# 3. Local Whisper Model Configuration (Optional)
# ------------------------------------------------------------------------------
# Path to local whisper model file (e.g. models/ggml-base.bin)
WHISPER_MODEL_PATH=models/ggml-base.bin
