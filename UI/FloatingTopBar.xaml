<Window x:Class="WiraVoice.UI.FloatingTopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WiraVoice.UI"
        mc:Ignorable="d"
        Title="Wira Voice"
        Height="72" Width="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="16" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Floating Island Card -->
    <Border CornerRadius="36" 
            Background="#EE14161D" 
            BorderBrush="#33FFFFFF" 
            BorderThickness="1.2"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="18,0,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Indicator & Audio Level Waveform -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#4CAF50"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="False">
                                    <Setter Property="Fill" Value="#757575"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Text="{Binding Status}" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           Foreground="#80FFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Live Speech Transcript Display -->
            <TextBlock Grid.Column="1" 
                       Text="{Binding Transcript}" 
                       FontSize="13.5" 
                       FontWeight="Medium" 
                       Foreground="#F0FFFFFF" 
                       TextTrimming="CharacterEllipsis" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="4,0,16,0"/>

            <!-- Cloud / Local STT Toggle Button -->
            <Button Grid.Column="2" 
                    Click="OnToggleEngineModeClicked"
                    Background="#1E293B" 
                    BorderBrush="#3B82F6" 
                    BorderThickness="1" 
                    Padding="12,6" 
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡ " FontSize="11" Foreground="#38BDF8"/>
                    <TextBlock Text="{Binding EngineModeDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                </StackPanel>
            </Button>

            <!-- Microphone Listen/Stop Button -->
            <Button Grid.Column="3" 
                    Click="OnToggleListeningClicked"
                    Padding="14,6" 
                    VerticalAlignment="Center"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#2563EB"/>
                        <Setter Property="BorderBrush" Value="#60A5FA"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="BorderBrush" Value="#F87171"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FFFFFF">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Start Listening"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                    <Setter Property="Text" Value="Stop"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Grid>
    </Border>
</Window>
