<Window x:Class="WiraVoice.UI.FloatingTopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WiraVoice.UI"
        mc:Ignorable="d"
        Title="Wira Voice"
        Height="52"
        SizeToContent="Width"
        MinWidth="340"
        MaxWidth="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Icon Button Style -->
        <Style x:Key="NotchIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A2A30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#383842"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#2E2E33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Menu Item Style -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="iconPresenter" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#71717A" Margin="16,0,4,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#52525B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Separator Style -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Fill="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Compact Notch Card -->
    <Border Height="38"
            CornerRadius="19"
            Background="#141416"
            BorderBrush="#2A2A2E"
            BorderThickness="1"
            VerticalAlignment="Center"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="12,0,10,0">
            <Grid.ColumnDefinitions>
                <!-- 0: Audio Waveform Equalizer -->
                <ColumnDefinition Width="Auto"/>
                <!-- 1: Live Transcript / Placeholder -->
                <ColumnDefinition Width="*"/>
                <!-- 2: Right Control Buttons (Stop/Mic + Ellipsis) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 4-Bar Audio Waveform Indicator (Matching Computah's exact formula) -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        Margin="2,0,12,0">
                <Rectangle Width="3" Height="{Binding Bar0Height}" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
                <Rectangle Width="3" Height="{Binding Bar1Height}" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
                <Rectangle Width="3" Height="{Binding Bar2Height}" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
                <Rectangle Width="3" Height="{Binding Bar3Height}" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Live Speech Transcript / Status Text -->
            <TextBlock Grid.Column="1" 
                       Text="{Binding DisplayText}" 
                       FontSize="13.5" 
                       FontWeight="Medium" 
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                       TextTrimming="CharacterEllipsis" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="2,0,14,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter Property="Foreground" Value="#9E9E9E"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Right Controls: Toggle Button + Options Menu -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">

                <!-- Stop (■) / Mic (🎤) Toggle Button -->
                <Button Width="26" Height="26"
                        Style="{StaticResource NotchIconButtonStyle}"
                        ToolTip="{Binding ListenButtonTooltip}"
                        Click="OnToggleListeningClicked">
                    <Grid>
                        <!-- Solid White Square when Listening (Matching Screenshot) -->
                        <Rectangle Width="10.5" Height="10.5" 
                                   RadiusX="1.5" RadiusY="1.5" 
                                   Fill="#FFFFFF">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!-- Sleek Microphone Icon when Idle -->
                        <Path Width="12" Height="12" 
                              Stretch="Uniform" 
                              Fill="#D4D4D8" 
                              Data="M12,2 A3,3 0 0,0 9,5 L9,11 A3,3 0 0,0 15,11 L15,5 A3,3 0 0,0 12,2 M19,10 A1,1 0 0,0 17,10 C17,12.76 14.76,15 12,15 C9.24,15 7,12.76 7,10 A1,1 0 0,0 5,10 C5,13.53 7.61,16.43 11,16.92 L11,19 L8,19 A1,1 0 0,0 8,21 L16,21 A1,1 0 0,0 16,19 L13,19 L13,16.92 C16.39,16.43 19,13.53 19,10 Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <!-- More Options Button (···) -->
                <Button x:Name="MoreButton"
                        Width="26" Height="26"
                        Margin="2,0,0,0"
                        Style="{StaticResource NotchIconButtonStyle}"
                        ToolTip="More options"
                        Click="OnMoreOptionsClicked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="#CCCCCC" Margin="1,0"/>
                        <Ellipse Width="3" Height="3" Fill="#CCCCCC" Margin="1,0"/>
                        <Ellipse Width="3" Height="3" Fill="#CCCCCC" Margin="1,0"/>
                    </StackPanel>

                    <!-- Context Menu for Quick Engine Switching & Diagnostics -->
                    <Button.ContextMenu>
                        <ContextMenu x:Name="NotchContextMenu">
                            <MenuItem Header="Cloud (Deepgram Flux)" 
                                      Click="OnSelectCloudEngineClicked">
                                <MenuItem.Icon>
                                    <TextBlock Text="✓" Foreground="#38BDF8" FontWeight="Bold" 
                                               Visibility="{Binding IsCloudMode, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Local (Whisper.cpp GPU)" 
                                      Click="OnSelectLocalEngineClicked">
                                <MenuItem.Icon>
                                    <TextBlock Text="✓" Foreground="#38BDF8" FontWeight="Bold" 
                                               Visibility="{Binding IsLocalMode, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator/>

                            <MenuItem Header="Clear Transcript" Click="OnClearTranscriptClicked"/>
                            <MenuItem Header="Open Diagnostics Report" Click="OnOpenDiagnosticsClicked"/>

                            <Separator/>

                            <MenuItem Header="Exit Wira Voice" Click="OnExitClicked"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
